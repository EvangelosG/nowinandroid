# Everything app-specific about this skill lives here; the scripts stay generic.
# Copy this file into another repo's copy of the skill and change these values.
# Environment variables win over what is set here.

APP_MODULE="${APP_MODULE:-:app}"
VARIANT="${VARIANT:-DemoDebug}"          # nowinandroid has demo/prod flavors
UNIT_TASKS="${UNIT_TASKS:-:core:domain:testDemoDebugUnitTest :feature:search:impl:testDemoDebugUnitTest}"
PAUSE_ARG="${PAUSE_ARG:-demoPauseMs}"    # read by NavigationTest
AVD="${AVD:-test_device}"
